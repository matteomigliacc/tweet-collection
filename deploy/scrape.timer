[Unit]
Description=Run the tweet collection 5x/day, jittered

[Timer]
# 01:00, 06:00, 11:00, 16:00, 21:00 local time (container TZ = Europe/Amsterdam),
# each shifted by up to 2h so runs land at varied times of day.
OnCalendar=*-*-* 01,06,11,16,21:00
RandomizedDelaySec=2h
Persistent=true

[Install]
WantedBy=timers.target
